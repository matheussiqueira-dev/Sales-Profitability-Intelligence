	partition dim_seller = m
		mode: import
		source =
				let
				    Csv = Csv.Document(File.Contents(DataFolder & "/dim_seller.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
				    Snapshot = Table.TransformColumnTypes(Headers,{{"seller_key",Int64.Type},{"seller_id",Int64.Type},{"seller_name",type text},{"region",type text}},"en-US"),
				    PostgreSQLSource = PostgreSQL.Database(ServerName,DatabaseName,[CreateNavigationProperties=false]),
				    SqlTable = PostgreSQLSource{[Schema="analytics",Item="dim_seller"]}[Data],
				    Result = if SourceMode = "PostgreSQL" then SqlTable else Snapshot
				in Result

