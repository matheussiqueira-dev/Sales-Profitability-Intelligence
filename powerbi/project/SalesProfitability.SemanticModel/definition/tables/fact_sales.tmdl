table fact_sales
	lineageTag: 62e727a4-be73-477c-bc2e-dea7e38c52a6

	/// Contrato V2: Receita Bruta. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Receita Bruta' = SUM(fact_sales[gross_revenue])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: 8e59af93-d266-4b37-b4f2-6e834328c775

	/// Contrato V2: Descontos. Dados sintéticos; contribuição não é lucro líquido.
	measure Descontos = SUM(fact_sales[discount_value])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: 7a55e3b9-dd99-4fb7-954a-7c002ea0ea9c

	/// Contrato V2: Devoluções. Dados sintéticos; contribuição não é lucro líquido.
	measure Devoluções = SUM(fact_sales[return_value])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: 1ef38f07-0189-476d-a4ef-ad41a3aa1f51

	/// Contrato V2: Receita Líquida. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Receita Líquida' = SUM(fact_sales[net_revenue])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: 175a178a-16e2-4cec-a820-66f96ad58f63

	/// Contrato V2: CMV. Dados sintéticos; contribuição não é lucro líquido.
	measure CMV = SUM(fact_sales[total_product_cost])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: bf93c2a2-0b73-445d-91b1-ff93d0d06a56

	/// Contrato V2: Frete. Dados sintéticos; contribuição não é lucro líquido.
	measure Frete = SUM(fact_sales[freight_allocated])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: ed0cbe64-d686-4631-8275-5fc094b61cc2

	/// Contrato V2: Custos Variáveis. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Custos Variáveis' = SUM(fact_sales[variable_cost_value])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: ca8ac044-3e61-4a08-b1a1-26d34543c421

	/// Contrato V2: Margem. Dados sintéticos; contribuição não é lucro líquido.
	measure Margem = SUM(fact_sales[contribution_margin])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: ba54c68d-6b34-4e37-9e07-bf751bc1237e

	/// Contrato V2: Margem %. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Margem %' = DIVIDE([Margem],[Receita Líquida])
		formatString: 0.00%
		displayFolder: Executivo
		lineageTag: 1e14f0d6-f174-4167-a1fa-b5d109cfb0a1

	/// Contrato V2: Pedidos. Dados sintéticos; contribuição não é lucro líquido.
	measure Pedidos = DISTINCTCOUNT(fact_sales[order_id])
		formatString: #,0
		displayFolder: Executivo
		lineageTag: 36dff9c6-e690-45f3-bebe-de217e451fb7

	/// Contrato V2: Clientes Ativos. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Clientes Ativos' = DISTINCTCOUNT(fact_sales[customer_key])
		formatString: #,0
		displayFolder: Executivo
		lineageTag: 1aa8dc3a-ca67-44ea-b0b9-865e758a1d4e

	/// Contrato V2: Ticket Médio. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Ticket Médio' = DIVIDE([Receita Líquida],[Pedidos])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: 9ea2ec3f-9d3e-43d5-9fd2-4bede72925f6

	/// Contrato V2: Desconto Médio %. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Desconto Médio %' = DIVIDE([Descontos],[Receita Bruta])
		formatString: 0.00%
		displayFolder: Executivo
		lineageTag: 4d0a6ada-3d26-43fa-988c-bbd781b0bc9f

	/// Contrato V2: Quantidade Vendida. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Quantidade Vendida' = SUM(fact_sales[quantity])
		formatString: #,0
		displayFolder: Executivo
		lineageTag: ffed859b-028e-412d-bdbb-7cf7a26a7aa7

	/// Contrato V2: Quantidade Devolvida. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Quantidade Devolvida' = SUM(fact_sales[returned_quantity])
		formatString: #,0
		displayFolder: Executivo
		lineageTag: e3dee07c-3515-43e3-9810-eef0f9e3907d

	/// Contrato V2: Taxa de Devolução. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Taxa de Devolução' = DIVIDE([Quantidade Devolvida],[Quantidade Vendida])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: fc5144f5-3b63-4bcc-b9b2-c290cc66a9e3

	/// Contrato V2: Desconto Selecionado. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Desconto Selecionado' = SELECTEDVALUE('Desconto Simulado'[Value],0)
		formatString: 0.00%
		displayFolder: Simulador
		lineageTag: 43deb321-46df-4b1e-8ca3-918254744ec6

	/// Contrato V2: Receita Simulada. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Receita Simulada' = SUMX(fact_sales,VAR B=ROUND((fact_sales[quantity]-fact_sales[returned_quantity])*fact_sales[unit_price]*100,0) VAR D=ROUND([Desconto Selecionado]*10000,0) VAR N=QUOTIENT(B*(10000-D)+5000,10000) RETURN CURRENCY(DIVIDE(N,100)))
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Simulador
		lineageTag: 64cc296c-5c5b-4215-8032-b9155c341bff

	/// Contrato V2: Custos Variáveis Simulados. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Custos Variáveis Simulados' = SUMX(fact_sales,VAR B=ROUND((fact_sales[quantity]-fact_sales[returned_quantity])*fact_sales[unit_price]*100,0) VAR D=ROUND([Desconto Selecionado]*10000,0) VAR N=QUOTIENT(B*(10000-D)+5000,10000) VAR R=ROUND(fact_sales[variable_cost_rate]*10000,0) VAR V=QUOTIENT(N*R+5000,10000)+ROUND(fact_sales[variable_cost_fixed]*100,0) RETURN CURRENCY(DIVIDE(V,100)))
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Simulador
		lineageTag: 989a99b8-7f1c-411e-a734-687402162cb4

	/// Contrato V2: Margem Simulada. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Margem Simulada' = [Receita Simulada]-[CMV]-[Frete]-[Custos Variáveis Simulados]
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Simulador
		lineageTag: 43b815f3-96ba-411d-a536-88b74bc879e0

	/// Contrato V2: Margem Simulada %. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Margem Simulada %' = DIVIDE([Margem Simulada],[Receita Simulada])
		formatString: 0.00%
		displayFolder: Simulador
		lineageTag: 4b85051d-bd78-42af-a97c-812f572eb52f

	/// Contrato V2: Impacto na Margem. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Impacto na Margem' = [Margem Simulada]-[Margem]
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Executivo
		lineageTag: a2c2fc52-6d86-4606-8e8b-b198d8d6f2c0

	/// Contrato V2: Volume Necessário %. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Volume Necessário %' = IF([Margem Simulada]>0 && [Margem]>0,DIVIDE([Margem],[Margem Simulada])-1,BLANK())
		formatString: 0.00%
		displayFolder: Simulador
		lineageTag: 20c7dac6-fd19-4cf5-9d95-7acaff3fb586

	/// Contrato V2: Base sem Desconto. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Base sem Desconto' = SUMX(fact_sales,(fact_sales[quantity]-fact_sales[returned_quantity])*fact_sales[unit_price])
		formatString: "R$" #,0.00; -"R$" #,0.00
		displayFolder: Simulador
		lineageTag: fe1c930f-dd2d-47db-a64f-edf7e67ded35

	/// Contrato V2: Taxa Variável Ponderada. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Taxa Variável Ponderada' = DIVIDE(SUMX(fact_sales,(fact_sales[quantity]-fact_sales[returned_quantity])*fact_sales[unit_price]*fact_sales[variable_cost_rate]),[Base sem Desconto])
		formatString: 0.00%
		displayFolder: Simulador
		lineageTag: db513616-9afe-496a-99a5-c7b854644389

	/// Contrato V2: Desconto Máximo para Margem 15%. Dados sintéticos; contribuição não é lucro líquido.
	measure 'Desconto Máximo para Margem 15%' = VAR D=1-[Taxa Variável Ponderada]-0.15 RETURN IF([Base sem Desconto]>0 && D>0,1-DIVIDE([CMV]+[Frete]+SUM(fact_sales[variable_cost_fixed]),[Base sem Desconto]*D),BLANK())
		formatString: 0.00%
		displayFolder: Simulador
		lineageTag: 3d4f9eab-0842-45f2-a486-0d0895bc8d2f

