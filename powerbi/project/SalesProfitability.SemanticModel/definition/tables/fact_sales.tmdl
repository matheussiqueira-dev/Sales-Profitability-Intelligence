	partition fact_sales = m
		mode: import
		source =
				let
				    Csv = Csv.Document(File.Contents(DataFolder & "/fact_sales.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
				    Snapshot = Table.TransformColumnTypes(Headers,{{"sale_key",Int64.Type},{"order_id",Int64.Type},{"order_item_id",Int64.Type},{"date_key",Int64.Type},{"customer_key",Int64.Type},{"product_key",Int64.Type},{"channel_key",Int64.Type},{"seller_key",Int64.Type},{"quantity",Int64.Type},{"unit_price",Currency.Type},{"gross_revenue",Currency.Type},{"discount_percentage",type number},{"discount_value",Currency.Type},{"net_revenue",Currency.Type},{"unit_cost",Currency.Type},{"total_product_cost",Currency.Type},{"freight_allocated",Currency.Type},{"returned_quantity",Int64.Type},{"return_value",Currency.Type},{"contribution_margin",Currency.Type},{"contribution_margin_percentage",type number},{"variable_cost_rate",type number},{"variable_cost_fixed",Currency.Type},{"variable_cost_value",Currency.Type}},"en-US"),
				    PostgreSQLSource = PostgreSQL.Database(ServerName,DatabaseName,[CreateNavigationProperties=false]),
				    SqlTable = PostgreSQLSource{[Schema="analytics",Item="fact_sales"]}[Data],
				    Result = if SourceMode = "PostgreSQL" then SqlTable else Snapshot
				in Result

