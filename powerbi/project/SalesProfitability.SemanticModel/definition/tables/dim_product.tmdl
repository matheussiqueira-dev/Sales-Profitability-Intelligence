	partition dim_product = m
		mode: import
		source =
				let
				    Csv = Csv.Document(File.Contents(DataFolder & "/dim_product.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
				    Snapshot = Table.TransformColumnTypes(Headers,{{"product_key",Int64.Type},{"product_id",Int64.Type},{"product_name",type text},{"category",type text},{"subcategory",type text},{"supplier",type text}},"en-US"),
				    PostgreSQLSource = PostgreSQL.Database(ServerName,DatabaseName,[CreateNavigationProperties=false]),
				    SqlTable = PostgreSQLSource{[Schema="analytics",Item="dim_product"]}[Data],
				    Result = if SourceMode = "PostgreSQL" then SqlTable else Snapshot
				in Result

