	partition dim_customer = m
		mode: import
		source =
				let
				    Csv = Csv.Document(File.Contents(DataFolder & "/dim_customer.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
				    Snapshot = Table.TransformColumnTypes(Headers,{{"customer_key",Int64.Type},{"customer_id",Int64.Type},{"customer_name",type text},{"customer_type",type text},{"segment",type text},{"city",type text},{"state",type text},{"region",type text}},"en-US"),
